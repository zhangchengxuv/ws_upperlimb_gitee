<?xml version="1.0" encoding="utf-8"?>
<robot name="robot_urdf">

  <!-- ===== 材质定义 ===== -->
  <material name="dark_graphite">
    <color rgba="0.36 0.40 0.45 1" />
  </material>

  <material name="light_mist">
    <color rgba="0.82 0.84 0.86 1" />
  </material>

  <!-- ===== world ===== -->
  <link name="world" />

  <joint name="world_to_base_link" type="fixed">
    <parent link="world" />
    <child link="base_link" />
    <origin xyz="0 0 0" rpy="1.5708 0 0" />
  </joint>

  <!-- ===== base ===== -->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://robot_urdf/meshes/base_link.STL" />
      </geometry>
      <material name="dark_graphite" />
    </visual>
  </link>

  <!-- ===== link1 ===== -->
  <link name="link1">
    <visual>
      <geometry>
        <mesh filename="package://robot_urdf/meshes/link1.STL" />
      </geometry>
      <material name="light_mist" />
    </visual>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link" />
    <child link="link1" />
    <origin xyz="0 0 0" rpy="0 0 -1.5708" />
    <axis xyz="0 0 -1" />
    <limit lower="-3.1416" upper="3.1416" effort="50" velocity="2" />
  </joint>

  <!-- ===== link2 ===== -->
  <link name="link2">
    <visual>
      <geometry>
        <mesh filename="package://robot_urdf/meshes/link2.STL" />
      </geometry>
      <material name="dark_graphite" />
    </visual>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1" />
    <child link="link2" />
    <origin xyz="0.0715 0 -0.0735" rpy="-1.5708 0 1.5708" />
    <axis xyz="0 0 -1" />
    <limit lower="-3.1416" upper="3.1416" effort="50" velocity="2" />
  </joint>

  <!-- ===== link3 ===== -->
  <link name="link3">
    <visual>
      <geometry>
        <mesh filename="package://robot_urdf/meshes/link3.STL" />
      </geometry>
      <material name="light_mist" />
    </visual>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="link2" />
    <child link="link3" />
    <origin xyz="0.19 0 -0.01" rpy="-3.1416 0 -1.5708" />
    <axis xyz="0 0 1" />
    <limit lower="-3.1416" upper="3.1416" effort="50" velocity="2" />
  </joint>

  <!-- ===== link4 ===== -->
  <link name="link4">
    <visual>
      <geometry>
        <mesh filename="package://robot_urdf/meshes/link4.STL" />
      </geometry>
      <material name="dark_graphite" />
    </visual>
  </link>

  <joint name="joint4" type="revolute">
    <parent link="link3" />
    <child link="link4" />
    <origin xyz="0.0545 0 -0.08" rpy="1.5708 0.95993 -1.5708" />
    <axis xyz="0 0 1" />
    <limit lower="-3.1416" upper="3.1416" effort="50" velocity="2" />
  </joint>

  <!-- ===== link5 ===== -->
  <link name="link5">
    <visual>
      <geometry>
        <mesh filename="package://robot_urdf/meshes/link5.STL" />
      </geometry>
      <material name="light_mist" />
    </visual>
  </link>

  <joint name="joint5" type="revolute">
    <parent link="link4" />
    <child link="link5" />
    <origin xyz="0.12776 0 -0.15315" rpy="-2.1198 0.29022 1.3975" />
    <axis xyz="0 0 -1" />
    <limit lower="-3.1416" upper="3.1416" effort="50" velocity="2" />
  </joint>

  <!-- ===== link6 ===== -->
  <link name="link6">
    <visual>
      <geometry>
        <mesh filename="package://robot_urdf/meshes/link6.STL" />
      </geometry>
      <material name="dark_graphite" />
    </visual>
  </link>

  <joint name="joint6" type="revolute">
    <parent link="link5" />
    <child link="link6" />
    <origin xyz="0.092667 0.0011397 0.094019" rpy="-2.3595 -0.78866 -0.93839" />
    <axis xyz="0 0 1" />
    <limit lower="-3.1416" upper="3.1416" effort="50" velocity="2" />
  </joint>

  <!-- ===== link7 ===== -->
  <link name="link7">
    <visual>
      <geometry>
        <mesh filename="package://robot_urdf/meshes/link7.STL" />
      </geometry>
      <material name="light_mist" />
    </visual>
  </link>

  <joint name="joint7" type="revolute">
    <parent link="link6" />
    <child link="link7" />
    <origin xyz="0.269 0 -0.008" />
    <axis xyz="0 0 1" />
    <limit lower="-3.1416" upper="3.1416" effort="50" velocity="2" />
  </joint>

  <!-- ===== link8 ===== -->
  <link name="link8">
    <visual>
      <geometry>
        <mesh filename="package://robot_urdf/meshes/link8.STL" />
      </geometry>
      <material name="dark_graphite" />
    </visual>
  </link>

  <joint name="joint8" type="revolute">
    <parent link="link7" />
    <child link="link8" />
    <origin xyz="0.18565 0 -0.075" rpy="-1.5708 0 1.5708" />
    <axis xyz="0 0 -1" />
    <limit lower="-3.1416" upper="3.1416" effort="50" velocity="2" />
  </joint>

  <!-- ===== link9 ===== -->
  <link name="link9">
    <visual>
      <geometry>
        <mesh filename="package://robot_urdf/meshes/link9.STL" />
      </geometry>
      <material name="light_mist" />
    </visual>
  </link>

  <joint name="joint9" type="revolute">
    <parent link="link8" />
    <child link="link9" />
    <origin xyz="0 -0.0508 -0.058" rpy="-1.5708 0 -3.1416" />
    <axis xyz="0 0 -1" />
    <limit lower="-3.1416" upper="3.1416" effort="50" velocity="2" />
  </joint>

  <!-- ===== link10 ===== -->
  <link name="link10">
    <visual>
      <geometry>
        <mesh filename="package://robot_urdf/meshes/link10.STL" />
      </geometry>
      <material name="dark_graphite" />
    </visual>
  </link>

  <joint name="joint10" type="revolute">
    <parent link="link9" />
    <child link="link10" />
    <origin xyz="-0.04495 0 -0.051" rpy="-1.5708 -0.01414 1.5708" />
    <axis xyz="0 0 -1" />
    <limit lower="-3.1416" upper="3.1416" effort="50" velocity="2" />
  </joint>

  <!-- ===== Force Torque Sensor ===== -->

  <link name="ft_sensor_frame">
    <visual>
      <geometry>
        <sphere radius="0.01" />
      </geometry>
      <material name="sensor_red">
        <color rgba="1 0 0 1" />
      </material>
    </visual>
  </link>

  <joint name="ft_sensor_joint" type="fixed">
    <parent link="link6" />
    <child link="ft_sensor_frame" />
    <origin xyz="0.18416 0 -0.01731" rpy="3.1351 0 -1.5708" />
  </joint>


  <link name="ft_sensor_frame_2">
    <visual>
      <geometry>
        <sphere radius="0.01" />
      </geometry>
      <material name="sensor_red">
        <color rgba="1 0 0 1" />
      </material>
    </visual>
  </link>

  <joint name="ft_sensor_joint_2" type="fixed">
    <parent link="link10" />
    <child link="ft_sensor_frame_2" />
    <origin xyz="0.082 -0.0287 -0.06447 " rpy="1.5643 -1.5225 1.5708" />
  </joint>

</robot>