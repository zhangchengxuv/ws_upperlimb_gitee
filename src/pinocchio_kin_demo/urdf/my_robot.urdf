<?xml version="1.0" encoding="utf-8"?>
<robot name="robot_urdf">

  <!-- ========= MATERIALS ========= -->

  <material name="robot_light">
    <color rgba="0.85 0.85 0.85 1"/>
  </material>

  <material name="robot_dark">
    <color rgba="0.45 0.45 0.45 1"/>
  </material>

  <material name="robot_blue">
    <color rgba="0.55 0.65 0.85 1"/>
  </material>

  <!-- ========= WORLD ========= -->

  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========= BASE ========= -->

  <link name="base_link">
    <inertial>
      <origin xyz="6.92226091734277E-06 0.023844578255847 -0.0295185415811063"/>
      <mass value="2.0518821290605"/>
      <inertia
        ixx="0.0033819502523036"
        ixy="6.94931922672856E-07"
        ixz="-3.13273230530951E-07"
        iyy="0.0025562496259904"
        iyz="0.000421721476417986"
        izz="0.00278965644158957"/>
    </inertial>

    <visual>
      <geometry>
        <mesh filename="package://robot_urdf/meshes/base_link.STL"/>
      </geometry>
      <material name="robot_dark"/>
    </visual>

    <collision>
      <geometry>
        <mesh filename="package://robot_urdf/meshes/base_link.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- ========= LINK1 ========= -->

  <link name="link1">
    <visual>
      <geometry>
        <mesh filename="package://robot_urdf/meshes/L1.STL"/>
      </geometry>
      <material name="robot_blue"/>
    </visual>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.0105" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57079632679" upper="1.57079632679" effort="100.0" velocity="2.0"/>
  </joint>

  <!-- ========= LINK2 ========= -->

  <link name="link2">
    <visual>
      <geometry>
        <mesh filename="package://robot_urdf/meshes/L2.STL"/>
      </geometry>
      <material name="robot_light"/>
    </visual>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0.0715 0.0735" rpy="1.5707963267949 -1.5707963267949 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57079632679" upper="1.57079632679" effort="100.0" velocity="2.0"/>
